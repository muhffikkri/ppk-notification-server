# Path ke Firebase service account JSON (jangan commit file-nya)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Expo access token untuk kirim push via Expo Push API
EXPO_PUSH_ACCESS_TOKEN=

# Opsional: port untuk healthcheck HTTP
PORT=8787

# Opsional: file log persisten (timestamp ISO)
LOG_FILE=./logs/server.log

# Opsional: interval pemrosesan antrean push (ms, default 60000)
QUEUE_INTERVAL_MS=60000

# Cloudflare Tunnel token (dashboard Zero Trust > Tunnels > token)
TUNNEL_TOKEN=
